# Environment Variables Example for zkLogin Integration

# App Configuration
NEXT_PUBLIC_APP_NAME="Sui dApp Starter"
NEXT_PUBLIC_APP_DESCRIPTION="Full-Stack Sui Starter on Steroids"

# zkLogin Configuration
# Get your Google Client ID from: https://console.cloud.google.com/
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
NEXT_PUBLIC_REDIRECT_URL=http://localhost:3000/auth/callback

# zkLogin Master Seed (CRITICAL FOR PRODUCTION)
# This generates deterministic salts for users
# WARNING: Changing this will generate different addresses and users will lose access to funds!
# For production: Use a secure random value and store it safely (e.g., AWS Secrets Manager, HashiCorp Vault)
ZKLOGIN_MASTER_SEED=your-secure-random-master-seed-here-change-for-production

# Optional: Mysten Labs Services (defaults will be used if not provided)
# NEXT_PUBLIC_MYSTEN_PROVER_URL=https://prover-dev.mystenlabs.com/v1

# Contract Package IDs (auto-updated after deployment)
# NEXT_PUBLIC_LOCALNET_CONTRACT_PACKAGE_ID=
# NEXT_PUBLIC_DEVNET_CONTRACT_PACKAGE_ID=
# NEXT_PUBLIC_TESTNET_CONTRACT_PACKAGE_ID=
# NEXT_PUBLIC_MAINNET_CONTRACT_PACKAGE_ID=
